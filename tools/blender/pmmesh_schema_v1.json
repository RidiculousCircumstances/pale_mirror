{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pale Mirror Mesh v1",
  "description": "Runtime asset exported from canonical Blender sources. Positions use PM coordinates: +Y up, +Z forward, one unit per Minecraft block.",
  "type": "object",
  "required": ["schema", "asset_id", "texture", "bounds", "meshes", "skeleton", "animations"],
  "properties": {
    "schema": {"const": "pale_mirror.pmmesh.v1"},
    "asset_id": {"type": "string", "pattern": "^[a-z0-9_/-]+$"},
    "texture": {"type": "string", "pattern": "^[a-z0-9_/-]+$"},
    "bounds": {
      "type": "object",
      "required": ["min", "max"],
      "properties": {
        "min": {"$ref": "#/$defs/vector3"},
        "max": {"$ref": "#/$defs/vector3"}
      }
    },
    "meshes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mesh"}
    },
    "skeleton": {
      "type": "object",
      "required": ["bones"],
      "properties": {
        "bones": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/bone"}}
      }
    },
    "animations": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "vector3": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 3,
      "maxItems": 3
    },
    "mesh": {
      "type": "object",
      "required": ["name", "lod", "positions", "normals", "uvs", "indices", "joints", "weights"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_/-]+$"},
        "lod": {"type": "integer", "minimum": 0, "maximum": 1},
        "positions": {"type": "array", "items": {"$ref": "#/$defs/vector3"}},
        "normals": {"type": "array", "items": {"$ref": "#/$defs/vector3"}},
        "uvs": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}},
        "indices": {"type": "array", "items": {"type": "integer", "minimum": 0}},
        "joints": {"type": "array", "items": {"type": "array", "items": {"type": "integer", "minimum": 0}, "minItems": 4, "maxItems": 4}},
        "weights": {"type": "array", "items": {"type": "array", "items": {"type": "number", "minimum": 0}, "minItems": 4, "maxItems": 4}}
      }
    },
    "bone": {
      "type": "object",
      "required": ["name", "parent", "head", "tail"],
      "properties": {
        "name": {"type": "string", "pattern": "^[A-Za-z0-9_/-]+$"},
        "parent": {"type": ["string", "null"]},
        "head": {"$ref": "#/$defs/vector3"},
        "tail": {"$ref": "#/$defs/vector3"}
      }
    }
  }
}
