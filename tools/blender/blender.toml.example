# Copy outside the repository, for example to
# ~/.config/pale-mirror/blender.toml.  Do not commit a machine-specific copy.

[connection]
host = "CHANGE_ME"
user = "CHANGE_ME"
identity_file = "~/.ssh/id_ed25519"
known_hosts_file = "~/.config/pale-mirror/windows-blender-known_hosts"
local_port = 19876
remote_port = 9876

[windows]
# An isolated workspace owned by the private Pale Mirror authoring setup.
workspace = "E:\\PaleMirror\\workspace\\pale-mirror"
