{
  "schema": 1,
  "id": "disposable_route_obstruction",
  "isolation": { "mode": "disposable_lite", "seed": 41 },
  "server": { "host": "127.0.0.1", "port": 25575, "profile": "scene-return" },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/gamemode creative PMTestPilot" },
    { "type": "command", "command": "/time set day" },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "summary", "id": "", "expect": { "status": "ok", "settlements": 12, "sites": 12 } },
      { "view": "operation", "id": "operation:supply-1-2", "expect": { "status": "ok", "stage": "EN_ROUTE", "routeIndex": 0, "participants": ["resident:1-16", "resident:1-28", "resident:1-30"] } }
    ] },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": -360, "y": 65, "z": -340 }, "settleMs": 1000 }
  ],
  "actions": [
    { "type": "wait_until_diagnostic", "view": "scene", "id": "operation:supply-1-2", "expect": { "status": "ok", "leaseStatus": "HOT", "primaryActor": "resident:1-16" }, "timeoutMs": 60000 },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": -380, "y": 65, "z": -304 }, "settleMs": 1000 },
    { "type": "wait_until_block", "position": { "x": -380, "y": 64, "z": -304 }, "block": "minecraft:gray_concrete", "timeoutMs": 30000 },
    { "type": "break", "position": { "x": -380, "y": 64, "z": -304 } },
    { "type": "wait_until_block", "position": { "x": -380, "y": 64, "z": -304 }, "block": "minecraft:air", "timeoutMs": 30000 },
    { "type": "wait_until_diagnostic", "view": "physical_delta", "id": "-380,64,-304", "expect": { "status": "ok", "deltaKind": "KNOWN_SEMANTIC_LOSS", "owner": "route:frontier-network", "semanticPart": "ROUTE_SURFACE", "causeKind": "PLAYER" }, "timeoutMs": 30000 },
    { "type": "inspect", "view": "physical_delta", "id": "-380,64,-304" },
    { "type": "wait_until_diagnostic", "view": "trace", "id": "physical-delta:-380,64,-304", "expect": { "status": "ok", "eventKind": "physical_delta_observed", "subject": "route:frontier-network" }, "timeoutMs": 30000 },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": 0, "y": 65, "z": 0 }, "settleMs": 1000 },
    { "type": "wait_until_diagnostic", "view": "scene", "id": "operation:supply-1-2", "expect": { "status": "ok", "leaseStatus": "CLOSED", "primaryActor": "resident:1-16" }, "timeoutMs": 60000 },
    { "type": "wait_until_diagnostic", "view": "operation", "id": "operation:supply-1-2", "expect": { "status": "ok", "stage": "FAILED" }, "timeoutMs": 30000 },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": -405, "y": 66, "z": 235 }, "settleMs": 1000 },
    { "type": "look", "at": { "x": -405, "y": 68, "z": 247 } },
    { "type": "assert_visible_board", "text": "ROUTE DAMAGE", "position": { "x": -405, "y": 68, "z": 247 }, "radius": 3, "maxDistance": 64, "maxAngleDeg": 50, "timeoutMs": 30000 },
    { "type": "inspect", "view": "operation", "id": "operation:supply-1-2" },
    { "type": "inspect", "view": "physical_delta", "id": "-380,64,-304" },
    { "type": "inspect", "view": "trace", "id": "physical-delta:-380,64,-304" }
  ],
  "assertions": [
    { "after": 17, "view": "operation", "id": "operation:supply-1-2", "expect": { "status": "ok", "stage": "FAILED" } },
    { "after": 17, "view": "physical_delta", "id": "-380,64,-304", "expect": { "status": "ok", "deltaKind": "KNOWN_SEMANTIC_LOSS", "owner": "route:frontier-network", "semanticPart": "ROUTE_SURFACE", "causeKind": "PLAYER" } },
    { "after": 17, "view": "trace", "id": "physical-delta:-380,64,-304", "expect": { "status": "ok", "eventKind": "physical_delta_observed", "subject": "route:frontier-network" } }
  ],
  "frames": [
    { "after": 14, "name": "route-damage-warning" }
  ]
}
