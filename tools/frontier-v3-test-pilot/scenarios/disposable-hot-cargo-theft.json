{
  "schema": 1,
  "id": "disposable_hot_cargo_theft",
  "isolation": { "mode": "disposable_lite", "seed": 41 },
  "server": { "host": "127.0.0.1", "port": 25575, "profile": "scene-return" },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/time set day" },
    { "type": "command", "command": "/clear PMTestPilot" },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "summary", "id": "", "expect": { "status": "ok", "settlements": 12, "sites": 12 } },
      { "view": "operation", "id": "operation:supply-1-2", "expect": { "status": "ok", "stage": "EN_ROUTE", "routeIndex": 0 } },
      { "view": "item", "id": "item:production-1-1-bread", "expect": { "status": "ok", "itemKind": "minecraft:bread", "count": 64, "custody": { "kind": "CARGO" } } }
