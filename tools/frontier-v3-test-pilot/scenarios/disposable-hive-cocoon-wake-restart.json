{
  "schema": 1,
  "id": "disposable_hive_cocoon_wake_restart",
  "isolation": { "mode": "disposable_lite", "seed": 41 },
  "server": { "host": "127.0.0.1", "port": 25575, "profile": "world", "viewDistance": 4 },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/gamemode creative PMTestPilot" },
    { "type": "command", "command": "/time set day" },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "summary", "id": "", "expect": { "status": "ok", "settlements": 12, "bioforms": 48 } },
      { "view": "actor", "id": "bioform:west-0", "expect": { "status": "ok", "actorKind": "BIOFORM", "lifecycle": "DORMANT", "ambientLease": "NONE", "cocoonHome": { "hibernaculum": "organ:west-hibernaculum-1", "slot": 0 } } }
    ] },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": -429, "y": 67, "z": 405 }, "settleMs": 1500 }
  ],
  "actions": [
    { "type": "wait_until_block", "position": { "x": -429, "y": 65, "z": 409 }, "block": "minecraft:white_concrete", "timeoutMs": 30000 },
    { "type": "look", "at": { "x": -429, "y": 65, "z": 409 } },
    { "type": "assert_visible_block", "position": { "x": -429, "y": 65, "z": 409 }, "timeoutMs": 30000 },
    { "type": "assert_visible_board", "text": "HIBERNACULUM", "position": { "x": -428, "y": 66, "z": 407 }, "radius": 3, "maxDistance": 64, "maxAngleDeg": 50, "timeoutMs": 30000 },
    { "type": "break", "position": { "x": -429, "y": 65, "z": 409 } },
    { "type": "wait_until_block", "position": { "x": -429, "y": 65, "z": 409 }, "block": "minecraft:air", "timeoutMs": 30000 },
    { "type": "wait_until_diagnostic", "view": "physical_delta", "id": "-429,65,409", "expect": { "status": "ok", "deltaKind": "KNOWN_SEMANTIC_LOSS", "owner": "bioform:west-0", "semanticPart": "COCOON", "causeKind": "PLAYER" }, "timeoutMs": 30000 },
    { "type": "wait_until_diagnostic", "view": "actor", "id": "bioform:west-0", "expect": { "status": "ok", "actorKind": "BIOFORM", "lifecycle": "WAKING", "ambientLease": "NONE" }, "timeoutMs": 30000 },
    { "type": "inspect", "view": "trace", "id": "physical-delta:-429,65,409" },
    { "type": "wait", "ms": 1000 },
    { "type": "wait_until_diagnostic", "view": "actor", "id": "bioform:west-0", "expect": { "status": "ok", "actorKind": "BIOFORM", "lifecycle": "ACTIVE", "ambientLease": "HOT" }, "timeoutMs": 60000 },
    { "type": "look_nearest_entity", "entityType": "minecraft:zombie", "nameContains": "HIVE", "maxDistance": 32, "timeoutMs": 30000 }
  ],
  "restart": {
    "mode": "graceful",
    "afterAction": 8,
    "resumeSetup": [
      { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": -429, "y": 67, "z": 405 }, "settleMs": 1500 },
      { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
        { "view": "physical_delta", "id": "-429,65,409", "expect": { "status": "ok", "deltaKind": "KNOWN_SEMANTIC_LOSS", "owner": "bioform:west-0", "semanticPart": "COCOON" } },
        { "view": "actor", "id": "bioform:west-0", "expect": { "status": "ok", "actorKind": "BIOFORM", "life": "ALIVE" } }
      ] }
    ]
  },
  "assertions": [
    { "after": 8, "view": "actor", "id": "bioform:west-0", "expect": { "status": "ok", "lifecycle": "WAKING", "ambientLease": "NONE" } },
    { "after": 9, "view": "physical_delta", "id": "-429,65,409", "expect": { "status": "ok", "deltaKind": "KNOWN_SEMANTIC_LOSS", "owner": "bioform:west-0", "semanticPart": "COCOON" } },
    { "after": 11, "view": "actor", "id": "bioform:west-0", "expect": { "status": "ok", "lifecycle": "ACTIVE", "ambientLease": "HOT" } }
  ],
  "frames": [
    { "after": 4, "name": "hibernaculum-cocoon-before-wake" },
    { "after": 12, "name": "hibernaculum-awakened-bioform" }
  ]
}
