{
  "schema": 1,
  "id": "disposable_redwillow_harvest",
  "isolation": { "mode": "disposable_lite", "seed": 41 },
  "server": { "host": "127.0.0.1", "port": 25575 },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/time set day" },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": 380, "y": 65, "z": -340 }, "settleMs": 1000 },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "summary", "id": "", "expect": { "status": "ok", "settlements": 12, "sites": 12 } },
      { "view": "settlement", "id": "settlement:4", "expect": { "status": "ok", "harvestAdmission": "NO_READY_SITE" } }
    ] }
  ],
  "actions": [
    { "type": "wait_until_block", "position": { "x": 388, "y": 64, "z": -355 }, "block": "minecraft:wheat", "timeoutMs": 90000 },
    { "type": "look", "at": { "x": 388, "y": 64, "z": -355 } },
    { "type": "assert_visible_block", "position": { "x": 388, "y": 64, "z": -355 }, "timeoutMs": 10000 },
    { "type": "look", "at": { "x": 392, "y": 67, "z": -357 } },
    { "type": "assert_visible_board", "text": "WHEAT FIELD", "position": { "x": 392, "y": 67, "z": -357 }, "radius": 3, "maxDistance": 64, "maxAngleDeg": 50, "timeoutMs": 30000 },
    { "type": "fast_forward", "ticks": 24000 },
    { "type": "wait_until_harvest_result", "siteId": "site:4-wheat-field", "intentId": "intent:site-harvest-4-wheat-field-1", "itemId": "item:site-harvest-4-wheat-field-1-wheat", "settlementId": "settlement:4", "timeoutMs": 180000 },
    { "type": "inspect", "view": "site", "id": "site:4-wheat-field" },
    { "type": "inspect", "view": "intent", "id": "intent:site-harvest-4-wheat-field-1" },
    { "type": "inspect", "view": "item", "id": "item:site-harvest-4-wheat-field-1-wheat" }
  ],
  "assertions": [
    { "after": 8, "view": "site", "id": "site:4-wheat-field", "expect": { "status": "ok", "phase": "GROWING", "growthEpoch": 2 } },
    { "after": 9, "view": "intent", "id": "intent:site-harvest-4-wheat-field-1", "expect": { "status": "ok", "intentStatus": "CONFIRMED" } },
    { "after": 10, "view": "item", "id": "item:site-harvest-4-wheat-field-1-wheat", "expect": { "status": "ok", "itemKind": "minecraft:wheat", "count": 64, "custody": { "kind": "CONTAINER_SLOT" } } }
  ],
  "frames": [
    { "after": 5, "name": "field-board-visible" }
  ]
}
