{
  "schema": 1,
  "id": "visible_hive_west_nest",
  "server": { "host": "127.0.0.1", "port": 25565 },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/gamemode creative PMTestPilot" },
    { "type": "command", "command": "/time set day" },
    { "type": "command", "command": "/execute in pale_mirror:frontier_graybox run tp PMTestPilot -420 74 402" }
  ],
  "actions": [
    { "type": "wait", "ms": 5000 },
    { "type": "wait", "ms": 3000 },
    { "type": "inspect", "view": "actor", "id": "bioform:west-0" },
    { "type": "inspect", "view": "summary", "id": "" },
    { "type": "look", "at": { "x": -420, "y": 64, "z": 420 } },
    { "type": "wait", "ms": 1000 }
  ],
  "assertions": [
    { "after": 3, "view": "actor", "id": "bioform:west-0", "expect": { "status": "ok", "actorKind": "BIOFORM", "life": "ALIVE", "ambientLease": "HOT" } },
    { "after": 4, "view": "summary", "id": "", "expect": { "status": "ok", "settlements": 12, "sites": 12 } }
  ],
  "frames": [
    { "after": 6, "name": "hive-west-nest" }
  ]
}
