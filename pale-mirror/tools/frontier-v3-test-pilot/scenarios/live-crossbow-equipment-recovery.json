{
  "schema": 1,
  "id": "live_crossbow_equipment_recovery",
  "server": {
    "host": "127.0.0.1",
    "port": 25565,
    "viewDistance": 6
  },
  "pilot": {
    "username": "PMBakeryAudit"
  },
  "setup": [
    {
      "type": "command",
      "command": "/gamemode creative"
    },
    {
      "type": "assert_fixture",
      "timeoutMs": 10000,
      "checks": [
        {
          "view": "actor",
          "id": "resident:1-4",
          "expect": {
            "status": "ok",
            "owner": "settlement:1",
            "life": "ALIVE",
            "guardMethod": "CROSSBOW"
          }
        }
      ]
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "container",
          "id": "container:1-depot",
          "field": "position"
        }
      },
      "offset": {
        "x": 2,
        "y": 0,
        "z": 0
      },
      "settleMs": 0
    }
  ],
  "actions": [
    {
      "type": "wait_until_diagnostic",
      "view": "actor",
      "id": "resident:1-4",
      "expect": {
        "status": "ok",
        "guardMethod": "CROSSBOW",
        "arrowsCarried": 32
      },
      "timeoutMs": 120000
    },
    {
      "type": "look_nearest_entity",
      "entityType": "minecraft:villager",
      "nameContains": {
        "diagnostic": {
          "view": "settlement_security",
          "id": "settlement:1",
          "field": "crossbowName"
        }
      },
      "maxDistance": 64,
      "timeoutMs": 10000
    },
    {
      "type": "inspect",
      "view": "actor",
      "id": "resident:1-4"
    },
    {
      "type": "inspect",
      "view": "settlement_security",
      "id": "settlement:1"
    }
  ],
  "assertions": [
    {
      "after": 3,
      "view": "actor",
      "id": "resident:1-4",
      "expect": {
        "guardMethod": "CROSSBOW",
        "arrowsCarried": 32,
        "shotPrepared": false
      }
    }
  ],
  "frames": [
    {
      "after": 2,
      "name": "same-guard-armed-after-recovery"
    }
  ]
}
