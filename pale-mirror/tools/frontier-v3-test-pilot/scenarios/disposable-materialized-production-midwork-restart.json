    { "type": "wait_until_diagnostic", "view": "item", "id": "item:development-production-input-theft-bread", "expect": { "status": "ok", "itemKind": "minecraft:bread", "count": 64, "custody": { "kind": "CONTAINER_SLOT" } }, "timeoutMs": 30000 },
    { "type": "inspect", "view": "container", "id": "container:1-depot" }
  ],
  "restart": {
    "mode": "graceful",
    "afterAction": 6,
    "resumeSetup": [
      { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": -388, "y": 64, "z": -326 }, "settleMs": 1000 }
    ]
  },
  "assertions": [
    { "after": 6, "view": "scene", "id": "job:production-development-input-theft", "expect": { "status": "ok", "sceneKind": "PRODUCTION_WORK", "leaseStatus": "HOT", "primaryActor": "resident:1-15", "productionStage": "PROCESSING" } },
    { "after": 5, "view": "market_order", "id": "order:development-production-input-theft", "expect": { "status": "ok", "orderStatus": "ACCEPTED", "jobActive": true, "reservationActive": true } },
    { "after": 7, "view": "market_order", "id": "order:development-production-input-theft", "expect": { "status": "ok", "orderStatus": "FULFILLED", "jobActive": false, "reservationActive": false, "taskStatus": "COMPLETED" } },
    { "after": 8, "view": "item", "id": "item:development-production-input-theft-bread", "expect": { "status": "ok", "itemKind": "minecraft:bread", "count": 64, "custody": { "kind": "CONTAINER_SLOT" } } },
    { "after": 9, "view": "container", "id": "container:1-depot", "expect": { "status": "ok", "surface": "ACTIVE", "replica": { "state": "OBSERVED_CURRENT", "conflict": "" } } }
  ],
  "frames": [{ "after": 4, "name": "industrial-worker-processing-before-restart" }]
