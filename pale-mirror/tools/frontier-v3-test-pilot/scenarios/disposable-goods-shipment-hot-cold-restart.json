  "assertions": [
    { "after": 9, "view": "process", "id": "shipment:development-goods", "expect": {
      "status": "ok", "result": { "stage": "CARRYING", "remainingQuantity": 32, "acceptedQuantity": 0 } } },
    { "after": 13, "view": "process", "id": "shipment:development-goods", "expect": {
