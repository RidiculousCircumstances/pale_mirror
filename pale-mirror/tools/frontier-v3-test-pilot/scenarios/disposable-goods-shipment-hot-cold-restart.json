{
  "schema": 1,
  "id": "disposable_goods_shipment_hot_cold_restart",
  "isolation": { "mode": "disposable_lite", "seed": 41 },
  "server": { "host": "127.0.0.1", "port": 25575, "profile": "goods-shipment", "viewDistance": 6 },
  "pilot": { "username": "PMTestPilot" },
  "restart": { "mode": "graceful", "afterAction": 8 },
  "setup": [
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "process", "id": "shipment:development-goods", "expect": {
