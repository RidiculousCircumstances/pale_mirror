      "offset": { "x": -8, "y": 2, "z": -8 }, "settleMs": 0,
      "causalMilestone": "ordinary_player_loads_receiver" },
    { "type": "release_fast_forward_hold" },
    { "type": "wait_until_diagnostic", "view": "process", "id": "shipment:development-goods",
