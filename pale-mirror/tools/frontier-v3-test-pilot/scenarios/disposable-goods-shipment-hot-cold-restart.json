    { "type": "wait_until_diagnostic", "view": "process", "id": "shipment:development-goods",
      "expect": { "status": "ok", "lease": null, "result": { "stage": "CARRYING", "remainingQuantity": 32, "acceptedQuantity": 0 } },
      "timeoutMs": 90000, "causalMilestone": "exact_cargo_and_actor_before_restart" },
    { "type": "inspect", "view": "process", "id": "shipment:development-goods",
