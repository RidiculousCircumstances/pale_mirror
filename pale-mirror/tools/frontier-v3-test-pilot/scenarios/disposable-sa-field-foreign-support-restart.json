      "expect": { "status": "ok", "eventKind": "resource_field_foreign_change_held:prewrite",
        "subject": "site:1-wheat-field" }, "timeoutMs": 15000 },
    { "type": "wait_until_diagnostic", "view": "trace", "id": "field-foreign-observed:site:1-wheat-field",
      "expect": { "status": "ok", "eventKind": "resource_field_foreign_cell_observed",
        "subject": "site:1-wheat-field" }, "timeoutMs": 60000 },
    { "type": "wait_until_diagnostic", "view": "field_physical", "id": "site:1-wheat-field",
      "expect": { "status": "ACTIVE", "claimKind": "OWNERSHIP", "layoutCurrent": true,
        "firstCellCanonical": { "soil": "OBSTRUCTED", "crop": "OBSTRUCTED" },
        "firstCellForeign": true, "foreignSoilName": "minecraft:stone",
        "foreignChangePending": false }, "timeoutMs": 20000 },
    { "type": "wait_until_block", "position": { "x": -343, "y": 63, "z": -346 },
      "block": "minecraft:stone", "timeoutMs": 10000 },
    { "type": "wait_until_diagnostic", "view": "field_physical", "id": "site:1-wheat-field",
      "expect": { "status": "ACTIVE", "firstCellCanonical": { "soil": "OBSTRUCTED", "crop": "OBSTRUCTED" },
        "firstCellForeign": true, "foreignSoilName": "minecraft:stone",
        "foreignChangePending": false }, "timeoutMs": 30000 }
  ],
  "restart": { "mode": "graceful", "afterAction": 3, "resumeSetup": [] },
  "assertions": [
    { "after": 5, "view": "field_physical", "id": "site:1-wheat-field", "expect": {
      "status": "ACTIVE", "claimKind": "OWNERSHIP", "layoutCurrent": true,
