    { "type": "wait_until_diagnostic", "view": "process", "id": "job:site-harvest-1-wheat-field-1",
      "expect": { "status": "ok", "conservation": { "totalCropSlots": 65,
        "completedCropSlots": 40, "deliveredYield": 0 } },
