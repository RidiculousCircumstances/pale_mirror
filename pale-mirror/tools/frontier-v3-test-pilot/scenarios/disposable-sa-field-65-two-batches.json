{
  "schema": 1,
  "id": "disposable_sa_field_65_two_batches",
  "isolation": { "mode": "disposable_lite", "seed": 125 },
  "server": { "host": "127.0.0.1", "port": 25586, "profile": "resource-site-harvest-65", "viewDistance": 6 },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/time set day" },
    { "type": "command", "command": "/gamerule doDaylightCycle false" },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "summary", "id": "", "expect": { "status": "ok", "settlements": 12, "sites": 12 } },
      { "view": "process", "id": "job:site-harvest-1-wheat-field-1", "expect": {
        "status": "ok", "conservation": { "completedCropSlots": 0, "totalCropSlots": 65,
          "deliveredYield": 0 }
      } }
    ] }
  ],
  "actions": [
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox",
