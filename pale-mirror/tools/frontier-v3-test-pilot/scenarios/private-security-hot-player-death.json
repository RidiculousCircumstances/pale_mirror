{
  "schema": 1,
  "id": "private_security_hot_player_death",
  "server": {
    "host": "127.0.0.1",
    "port": 25581
  },
  "pilot": {
    "username": "PMHotCivilian2"
  },
  "setup": [
    {
      "type": "command",
      "command": "/gamemode creative"
    },
    {
      "type": "command",
      "command": "/effect give @s minecraft:slow_falling 600 0 true"
    },
    {
      "type": "command",
      "command": "/attribute @s minecraft:generic.max_health base set 100"
    },
    {
      "type": "command",
      "command": "/effect give @s minecraft:instant_health 1 30 true"
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardPosition"
        }
      },
      "settleMs": 1000
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardPosition"
        }
      },
      "settleMs": 0
    },
    {
      "type": "command",
      "command": "/gamemode survival"
    }
  ],
  "actions": [
    {
      "type": "look_nearest_entity",
      "entityType": "minecraft:villager",
      "nameContains": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardName"
        }
      },
      "maxDistance": 64,
      "timeoutMs": 30000
    },
    {
      "type": "wait_until_diagnostic",
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "contactKind": "PLAYER"
        }
      },
      "timeoutMs": 120000,
      "pollIntervalMs": 100
    },
    {
      "type": "wait_until_player_health",
      "minimum": 0,
      "maximum": 0,
      "timeoutMs": 120000
    },
    {
      "type": "wait_until_diagnostic",
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "hostilePlayers": 2,
          "contactKind": null,
          "respondingGuards": 0
        }
      },
      "timeoutMs": 120000,
      "pollIntervalMs": 100
    },
    {
      "type": "inspect",
      "view": "settlement",
      "id": "settlement:1"
    }
  ],
  "assertions": [
    {
      "after": 5,
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "hostilePlayers": 2,
          "contactKind": null,
          "respondingGuards": 0
        }
      }
    }
  ],
  "frames": [
    {
      "after": 1,
      "name": "guards-before-remembered-player-combat"
    },
    {
      "after": 3,
      "name": "native-player-death",
      "presentation": "player"
    }
  ]
}
