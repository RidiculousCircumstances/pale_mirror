{
  "schema": 1,
  "id": "disposable_sa_first_harvest_hand",
  "isolation": { "mode": "disposable_lite", "seed": 125 },
  "server": { "host": "127.0.0.1", "port": 26610, "profile": "resource-site-harvest-65", "viewDistance": 6 },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/time set day" },
    { "type": "command", "command": "/gamerule doDaylightCycle false" },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "process", "id": "job:site-harvest-1-wheat-field-1", "expect": {
        "status": "ok", "conservation": { "completedCropSlots": 0, "totalCropSlots": 65 }
      } }
    ] }
  ],
  "actions": [
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox",
      "position": { "diagnostic": { "view": "site", "id": "site:1-wheat-field", "field": "firstCrop" } },
      "offset": { "x": -8, "y": 0, "z": -8 }, "settleMs": 1000 },
    { "type": "wait_until_diagnostic", "view": "process", "id": "job:site-harvest-1-wheat-field-1",
      "expect": { "status": "ok", "claims": { "lease": { "status": "HOT", "members": 1 } },
        "conservation": { "completedCropSlots": 0 } }, "timeoutMs": 120000 },
    { "type": "release_fast_forward_hold" },
    { "type": "wait_until_diagnostic", "view": "process", "id": "job:site-harvest-1-wheat-field-1",
      "expect": { "status": "ok", "claims": { "lease": { "status": "HOT" } },
        "conservation": { "completedCropSlots": 1, "harvestedYield": 1, "carriedYield": 1 } },
      "timeoutMs": 120000 }
  ],
  "assertions": [
    { "after": 4, "view": "process", "id": "job:site-harvest-1-wheat-field-1",
      "expect": { "status": "ok", "conservation": { "completedCropSlots": 1, "harvestedYield": 1 } } }
  ]
}
