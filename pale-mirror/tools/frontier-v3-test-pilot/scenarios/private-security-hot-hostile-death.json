{
  "schema": 1,
  "id": "private_security_hot_hostile_death",
  "server": {
    "host": "127.0.0.1",
    "port": 25581
  },
  "pilot": {
    "username": "PMTestPilot"
  },
  "setup": [
    {
      "type": "command",
      "command": "/gamemode creative"
    },
    {
      "type": "assert_fixture",
      "timeoutMs": 30000,
      "checks": [
        {
          "view": "settlement",
          "id": "settlement:1",
          "expect": {
            "status": "ok",
            "hasArmedGuard": true
          }
        }
      ]
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardPosition"
        }
      },
      "settleMs": 1000
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardPosition"
        }
      },
      "settleMs": 0
    },
    {
      "type": "command",
      "command": "/execute at @s run summon minecraft:zombie ~ ~ ~ {NoAI:1b,PersistenceRequired:1b,Silent:1b,ArmorItems:[{},{},{},{id:\"minecraft:iron_helmet\",count:1}],CustomName:'{\"text\":\"Security probe\"}',CustomNameVisible:1b}"
    }
  ],
  "actions": [
    {
      "type": "wait_until_diagnostic",
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "contactKind": "HOSTILE_MOB"
        }
      },
      "timeoutMs": 60000,
      "pollIntervalMs": 100
    },
    {
      "type": "wait_until_diagnostic",
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "contactKind": null,
          "respondingGuards": 0
        }
      },
      "timeoutMs": 60000,
      "pollIntervalMs": 100
    },
    {
      "type": "look_nearest_entity",
      "entityType": "minecraft:villager",
      "nameContains": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardName"
        }
      },
      "maxDistance": 64,
      "timeoutMs": 30000
    },
    {
      "type": "observe_entity_motion",
      "id": "security-patrol-after-threat",
      "entityType": "minecraft:villager",
      "nameContains": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardName"
        }
      },
      "durationTicks": 160,
      "sampleEveryTicks": 5,
      "maxDistance": 128,
      "timeoutMs": 30000
    },
    {
      "type": "inspect",
      "view": "settlement",
      "id": "settlement:1"
    }
  ],
  "assertions": [
    {
      "after": 5,
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "contactKind": null,
          "respondingGuards": 0
        }
      }
    }
  ],
  "frames": [
    {
      "after": 3,
      "name": "guard-after-hostile-death"
    }
  ]
}
