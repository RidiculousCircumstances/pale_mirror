{
  "schema": 1,
  "id": "private_security_hot_patrol",
  "server": {
    "host": "127.0.0.1",
    "port": 25581
  },
  "pilot": {
    "username": "pmhotwatch"
  },
  "setup": [
    {
      "type": "command",
      "command": "/gamemode creative"
    },
    {
      "type": "assert_fixture",
      "timeoutMs": 30000,
      "checks": [
        {
          "view": "settlement",
          "id": "settlement:1",
          "expect": {
            "status": "ok",
            "hasArmedGuard": true
          }
        }
      ]
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "routeSurface"
        }
      },
      "settleMs": 1000
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "firstGuardPosition"
        }
      },
      "settleMs": 0
    },
    {
      "type": "command",
      "command": "/tp @s ~3 ~3 ~"
    },
    {
      "type": "assert_fixture",
      "timeoutMs": 60000,
      "checks": [
        {
          "view": "actor",
          "id": "resident:1-16",
          "expect": {
            "status": "ok",
            "physicalAdmission": {
              "status": "INDEXED"
            }
          }
        }
      ]
    },
    {
      "type": "command",
      "command": "/tp @s f786e0b1-0619-31ad-aafa-5993d44220f0"
    }
  ],
  "actions": [
    {
      "type": "inspect",
      "view": "actor",
      "id": "resident:1-16"
    },
    {
      "type": "look_nearest_entity",
      "entityType": "minecraft:villager",
      "nameContains": {
        "diagnostic": {
          "view": "actor",
          "id": "resident:1-16",
          "field": "name"
        }
      },
      "maxDistance": 16,
      "timeoutMs": 30000
    },
    {
      "type": "observe_entity_motion",
      "id": "guard-patrol-after-combat",
      "entityType": "minecraft:villager",
      "workerId": "resident:1-16",
      "nameContains": {
        "diagnostic": {
          "view": "actor",
          "id": "resident:1-16",
          "field": "name"
        }
      },
      "durationTicks": 320,
      "sampleEveryTicks": 5,
      "maxDistance": 128,
      "timeoutMs": 30000
    },
    {
      "type": "inspect",
      "view": "settlement",
      "id": "settlement:1"
    }
  ],
  "assertions": [
    {
      "after": 4,
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "respondingGuards": 0
        }
      }
    }
  ],
  "frames": [
    {
      "after": 2,
      "name": "retained-armed-guard-after-combat"
    }
  ]
}
