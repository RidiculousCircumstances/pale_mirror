{
  "schema": 1,
  "id": "disposable_northwatch_player_withdrawal",
  "isolation": { "mode": "disposable_lite", "seed": 41 },
  "server": { "host": "127.0.0.1", "port": 25575 },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/time set day" },
    { "type": "command", "command": "/clear PMTestPilot" },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": { "x": -340, "y": 65, "z": -329 }, "settleMs": 1000 },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "summary", "id": "", "expect": { "status": "ok", "settlements": 12 } },
      { "view": "item", "id": "item:bootstrap-1-wheat", "expect": { "status": "ok", "itemKind": "minecraft:wheat", "count": 64, "custody": { "kind": "CONTAINER_SLOT" } } }
    ] }
  ],
  "actions": [
    { "type": "wait_until_block", "position": { "x": -340, "y": 65, "z": -326 }, "block": "minecraft:chest", "timeoutMs": 30000 },
    { "type": "open_container", "position": { "x": -340, "y": 65, "z": -326 }, "timeoutMs": 10000 },
    { "type": "quick_move_from_container", "item": "minecraft:wheat", "count": 64, "timeoutMs": 30000 },
    { "type": "wait_until_diagnostic", "view": "item", "id": "item:bootstrap-1-wheat", "expect": { "status": "ok", "itemKind": "minecraft:wheat", "count": 64, "custody": { "kind": "PLAYER" } }, "timeoutMs": 30000 },
    { "type": "inspect", "view": "container", "id": "container:1-depot" }
  ],
  "assertions": [
    { "after": 4, "view": "item", "id": "item:bootstrap-1-wheat", "expect": { "status": "ok", "itemKind": "minecraft:wheat", "count": 64, "custody": { "kind": "PLAYER" } } },
    { "after": 5, "view": "container", "id": "container:1-depot", "expect": { "status": "ok", "surface": "ACTIVE", "occupiedCount": 0 } }
  ],
  "frames": [
    { "after": 3, "name": "withdrawn-wheat", "presentation": "player" }
  ]
}
