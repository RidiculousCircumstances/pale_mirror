{
  "schema": 1,
  "id": "private_security_hot_civilian_assault",
  "server": {
    "host": "127.0.0.1",
    "port": 25581
  },
  "pilot": {
    "username": "PMHotCivilian2"
  },
  "setup": [
    {
      "type": "command",
      "command": "/gamemode creative"
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "actor",
          "id": "resident:1-1",
          "field": "position"
        }
      },
      "settleMs": 1000
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "actor",
          "id": "resident:1-1",
          "field": "position"
        }
      },
      "settleMs": 0
    },
    {
      "type": "command",
      "command": "/effect give @s minecraft:slow_falling 600 0 true"
    },
    {
      "type": "command",
      "command": "/effect give @s minecraft:instant_health 1 10 true"
    },
    {
      "type": "command",
      "command": "/gamemode survival"
    }
  ],
  "actions": [
    {
      "type": "look_nearest_entity",
      "entityType": "minecraft:villager",
      "nameContains": {
        "diagnostic": {
          "view": "actor",
          "id": "resident:1-1",
          "field": "name"
        }
      },
      "maxDistance": 64,
      "timeoutMs": 30000
    },
    {
      "type": "attack_nearest_entity",
      "entityType": "minecraft:villager",
      "nameContains": {
        "diagnostic": {
          "view": "actor",
          "id": "resident:1-1",
          "field": "name"
        }
      },
      "maxDistance": 32,
      "maxAttacks": 1,
      "requireRemoval": false,
      "requireDamage": true,
      "timeoutMs": 30000
    },
    {
      "type": "wait_until_diagnostic",
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "hostilePlayers": 2
        }
      },
      "timeoutMs": 60000,
      "pollIntervalMs": 100
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "settlement",
          "id": "settlement:1",
          "field": "routeSurface"
        }
      },
      "settleMs": 0
    },
    {
      "type": "wait_until_diagnostic",
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "contactKind": "PLAYER"
        }
      },
      "timeoutMs": 120000,
      "pollIntervalMs": 100
    },
    {
      "type": "wait_until_player_health",
      "maximum": 19,
      "minimum": 1,
      "timeoutMs": 120000
    },
    {
      "type": "visit",
      "dimension": "minecraft:overworld",
      "position": {
        "x": 12,
        "y": 51,
        "z": -138
      },
      "settleMs": 15000
    },
    {
      "type": "wait_until_diagnostic",
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "hostilePlayers": 2,
          "respondingGuards": 0
        }
      },
      "timeoutMs": 60000,
      "pollIntervalMs": 100
    },
    {
      "type": "inspect",
      "view": "settlement",
      "id": "settlement:1"
    }
  ],
  "assertions": [
    {
      "after": 9,
      "view": "settlement",
      "id": "settlement:1",
      "expect": {
        "status": "ok",
        "security": {
          "hostilePlayers": 2,
          "respondingGuards": 0
        }
      }
    }
  ],
  "frames": [
    {
      "after": 1,
      "name": "civilian-before-player-assault"
    }
  ]
