{
  "schema": 1,
  "id": "live_smeltery_supply",
  "server": { "host": "127.0.0.1", "port": 25565 },
  "pilot": { "username": "PMTestPilot" },
  "setup": [
    { "type": "command", "command": "/gamemode creative" },
    { "type": "assert_fixture", "timeoutMs": 30000, "checks": [
      { "view": "process", "id": "station:structure-7-smeltery", "expect": { "status": "ok", "result": { "operation": null } } }
    ] },
    { "type": "command", "command": "/give PMTestPilot minecraft:raw_iron 3" },
    { "type": "command", "command": "/give PMTestPilot minecraft:coal 1" }
  ],
  "actions": [
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": {
      "diagnostic": { "view": "container", "id": "container:structure-7-smeltery-metals", "field": "position" }
    }, "offset": { "x": -2, "y": 0, "z": 0 }, "settleMs": 0 },
    { "type": "wait_until_block", "position": {
      "diagnostic": { "view": "container", "id": "container:structure-7-smeltery-metals", "field": "position" }
    }, "block": "minecraft:chest", "timeoutMs": 60000 },
    { "type": "open_container", "position": {
      "diagnostic": { "view": "container", "id": "container:structure-7-smeltery-metals", "field": "position" }
    }, "timeoutMs": 30000 },
    { "type": "wait_until_diagnostic", "view": "container", "id": "container:structure-7-smeltery-metals", "expect": {
      "status": "ok", "custody": { "status": "ACQUIRED" }, "replica": { "state": "OBSERVED_CURRENT" }
    }, "timeoutMs": 30000 },
    { "type": "quick_move_from_inventory", "item": "minecraft:raw_iron", "count": 3, "timeoutMs": 30000 },
    { "type": "quick_move_from_inventory", "item": "minecraft:coal", "count": 1, "timeoutMs": 30000 },
    { "type": "close_container", "causalMilestone": "ordinary_player_supplies_warehouse_not_machine" },
    { "type": "wait_until_diagnostic", "view": "process", "id": "station:structure-7-smeltery", "expect": {
      "status": "ok", "result": { "operation": { "recipe": "pale_mirror:iron_smelting", "mode": "AUTOMATIC", "initiator": "SETTLEMENT" } }
    }, "timeoutMs": 180000 },
    { "type": "visit", "dimension": "pale_mirror:frontier_graybox", "position": {
      "diagnostic": { "view": "container", "id": "container:structure-7-smeltery-station", "field": "position" }
    }, "offset": { "x": -2, "y": -1, "z": 0 }, "settleMs": 0 },
    { "type": "open_container", "position": {
      "diagnostic": { "view": "container", "id": "container:structure-7-smeltery-station", "field": "position" }
    }, "timeoutMs": 30000 },
    { "type": "close_container" },
    { "type": "wait_until_container_item", "containerId": "container:structure-7-smeltery-metals", "item": "minecraft:iron_ingot", "count": 3, "timeoutMs": 180000,
      "causalMilestone": "shared_hauling_delivers_automatically_smelted_output" },
    { "type": "inspect", "view": "process", "id": "station:structure-7-smeltery" },
    { "type": "inspect", "view": "summary", "id": "" }
  ],
  "assertions": [
    { "after": 14, "view": "summary", "id": "", "expect": { "status": "ok", "requiredConflicts": 0, "sceneConflicts": 0, "inventoryConflicts": 0 } }
  ],
  "frames": [ { "after": 7, "name": "smeltery-warehouse" }, { "after": 10, "name": "automatic-smelter-ui", "presentation": "player" }, { "after": 12, "name": "finished-smeltery" } ]
}
