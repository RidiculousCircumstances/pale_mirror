    {
      "type": "look",
      "at": {
        "diagnostic": {
          "view": "container",
          "id": "container:structure-1-forge-station",
          "field": "position"
        }
      }
    },
    {
      "type": "wait_until_diagnostic",
      "view": "item",
      "id": "item:tool-test-target",
      "expect": {
        "status": "ok",
        "condition": {
          "maxDamage": 131,
          "damage": 35
        },
        "custody": {
          "kind": "CONTAINER_SLOT",
          "container": "container:1-depot"
        }
      },
      "timeoutMs": 240000,
      "causalMilestone": "same_worn_tool_repaired_and_delivered"
    },
    {
      "type": "wait_until_diagnostic",
      "view": "process",
      "id": "job:production-tool-test",
      "expect": {
        "status": "not_found"
      },
      "timeoutMs": 30000
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "container",
          "id": "container:1-depot",
          "field": "position"
        }
      },
      "offset": {
        "x": -3,
        "y": 0,
        "z": -3
      },
      "settleMs": 1000
    },
    {
      "type": "open_container",
      "position": {
        "diagnostic": {
          "view": "container",
          "id": "container:1-depot",
          "field": "position"
        }
      },
      "timeoutMs": 30000
    }
  ],
  "restart": {
    "mode": "graceful",
    "afterAction": 3,
    "resumeSetup": [
      {
        "type": "visit",
        "dimension": "pale_mirror:frontier_graybox",
        "position": {
          "diagnostic": {
