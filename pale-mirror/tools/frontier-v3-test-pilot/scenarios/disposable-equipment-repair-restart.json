            "id": "container:structure-1-forge-station",
            "field": "position"
          }
        },
        "offset": {
          "x": -7,
          "y": -1,
          "z": -5
        },
        "settleMs": 1000
      }
    ]
  },
  "assertions": [
    {
      "after": 4,
      "view": "item",
      "id": "item:tool-test-target",
      "expect": {
        "status": "ok",
        "owner": "settlement:1",
        "condition": {
          "maxDamage": 131,
          "damage": 35
        },
        "custody": {
          "kind": "CONTAINER_SLOT",
          "container": "container:1-depot"
        }
      }
    }
  ],
  "frames": [
    {
      "after": 3,
      "name": "forge-entrance-before-restart"
    },
    {
      "after": 7,
      "name": "same-repaired-tool-in-warehouse",
      "presentation": "player"
    }
  ]
