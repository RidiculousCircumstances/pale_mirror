{
  "schema": 1,
  "id": "disposable_equipment_repair_restart",
  "isolation": {
    "mode": "disposable_lite",
    "seed": 41
  },
  "server": {
    "host": "127.0.0.1",
    "port": 25575,
    "profile": "equipment-repair"
  },
  "pilot": {
    "username": "PMTestPilot"
  },
  "setup": [
    {
      "type": "command",
      "command": "/gamemode creative PMTestPilot"
    },
    {
      "type": "visit",
      "dimension": "pale_mirror:frontier_graybox",
      "position": {
        "diagnostic": {
          "view": "container",
          "id": "container:structure-1-forge-station",
          "field": "position"
        }
      },
      "offset": {
        "x": -7,
        "y": -1,
        "z": -5
      },
      "settleMs": 1000
    },
    {
      "type": "assert_fixture",
      "timeoutMs": 30000,
      "checks": [
        {
          "view": "item",
          "id": "item:tool-test-target",
          "expect": {
            "status": "ok",
            "condition": {
              "maxDamage": 131,
              "damage": 100
            }
          }
        }
      ]
    }
  ],
  "actions": [
    {
      "type": "release_fast_forward_hold"
    },
    {
      "type": "wait_until_diagnostic",
      "view": "scene",
      "id": "job:production-tool-test",
      "expect": {
        "status": "ok",
        "leaseStatus": "HOT"
