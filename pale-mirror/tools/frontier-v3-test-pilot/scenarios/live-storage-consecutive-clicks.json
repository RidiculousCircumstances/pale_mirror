    { "after": 13, "view": "summary", "id": "", "expect": { "status": "ok", "requiredConflicts": 0, "inventoryConflicts": 0 } }
  ],
  "frames": [
    { "after": 6, "name": "three-consecutive-stack-deposits", "presentation": "player" },
    { "after": 10, "name": "three-consecutive-stack-withdrawals", "presentation": "player" }
