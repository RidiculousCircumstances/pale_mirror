    { "type": "quick_move_from_inventory", "item": "minecraft:granite", "count": 64, "timeoutMs": 10000 },
    { "type": "quick_move_from_inventory", "item": "minecraft:granite", "count": 64, "timeoutMs": 10000 },
    { "type": "inspect", "view": "container", "id": "container:observed--110_64_-333" },
    { "type": "quick_move_from_container", "item": "minecraft:granite", "count": 64, "timeoutMs": 10000 },
    { "type": "quick_move_from_container", "item": "minecraft:granite", "count": 64, "timeoutMs": 10000 },
    { "type": "quick_move_from_container", "item": "minecraft:granite", "count": 64, "timeoutMs": 10000 },
    { "type": "inspect", "view": "container", "id": "container:observed--110_64_-333" },
    { "type": "close_container" },
    { "type": "inspect", "view": "summary", "id": "" }
  ],
  "assertions": [
    { "after": 7, "view": "container", "id": "container:observed--110_64_-333",
